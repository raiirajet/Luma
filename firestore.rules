rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validListing(d) {
      return d.keys().hasAll(['title','description','price','country','category','city','contactEmail','condition','image','images','uid','status','createdAt','make','model','year','mileage','power','fuel','transmission','body','sellerType','accidentStatus','conditionNote'])
        && d.keys().hasOnly(['title','description','price','country','category','city','contactEmail','condition','image','images','uid','status','createdAt','make','model','year','mileage','power','fuel','transmission','body','sellerType','accidentStatus','conditionNote'])
        && d.uid is string && d.uid == request.auth.uid
        && d.title is string && d.title.size() >= 5 && d.title.size() <= 110
        && d.description is string && d.description.size() >= 15 && d.description.size() <= 3000
        && d.city is string && d.city.size() >= 1 && d.city.size() <= 90
        && d.contactEmail is string && d.contactEmail.size() <= 180
        && d.price is int && d.price >= 1 && d.price <= 999999999
        && d.category == 'vehicles'
        && d.country in ['AL','TR','GR','RS','SI','XK','MK','HR','BA','ME','BG','RO']
        && d.condition in ['new','used']
        && d.status in ['active','sold']
        && d.make is string && d.make.size() >= 2 && d.make.size() <= 35
        && d.model is string && d.model.size() >= 1 && d.model.size() <= 65
        && d.accidentStatus in ['yes','no','unknown']
        && d.conditionNote is string && d.conditionNote.size() <= 240
        && d.year is int && d.year >= 1950 && d.year <= 2027
        && d.mileage is int && d.mileage >= 0 && d.mileage <= 1500000
        && d.power is int && d.power >= 1 && d.power <= 2000
        && d.fuel in ['petrol','diesel','hybrid','electric']
        && d.transmission in ['manual','automatic']
        && d.body in ['suv','sedan','wagon','hatchback','coupe']
        && d.sellerType in ['privateSeller','dealer']
        && d.image is string && d.image.size() > 0 && d.image.size() <= 2048
        && d.images is list && d.images.size() >= 1 && d.images.size() <= 6
        && d.createdAt is timestamp;
    }
    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if verified() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && validListing(request.resource.data);
      allow update: if verified() && owner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validListing(request.resource.data);
      allow delete: if verified() && owner(resource.data.uid);
    }
    match /users/{uid}/favorites/{listingId} {
      allow read, write: if owner(uid);
    }
    match /users/{uid}/data/{dataId} {
      allow read: if owner(uid);
      allow write: if owner(uid) && dataId == 'searches'
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 20;
      allow write: if owner(uid) && dataId == 'preferences'
        && request.resource.data.keys().hasOnly(['countries'])
        && request.resource.data.countries is list
        && request.resource.data.countries.size() <= 12
        && request.resource.data.countries.hasOnly(['AL','TR','GR','RS','SI','XK','MK','HR','BA','ME','BG','RO']);
    }
    match /{document=**} { allow read, write: if false; }
  }
}