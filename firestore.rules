rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validListing(data) {
      return data.keys().hasAll(['title','description','price','country','category','city','contactEmail','condition','image','images','uid','status','createdAt'])
        && data.keys().hasOnly(['title','description','price','country','category','city','contactEmail','condition','image','images','uid','status','createdAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 110
        && data.description is string && data.description.size() >= 15 && data.description.size() <= 3000
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 90
        && data.contactEmail is string && data.contactEmail.size() <= 180
        && data.price is int && data.price >= 0 && data.price <= 999999999
        && data.category in ['vehicles','property','electronics','fashion','home','garden','kids','sports','jobs','services','pets','collectibles','music','tickets','other']
        && data.country in ['AL','TR','GR','RS','SI','XK','MK','HR','BA','ME','BG','RO']
        && data.condition in ['new','used']
        && data.status in ['active','sold']
        && data.image is string && data.image.size() > 0 && data.image.size() <= 2048
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 6
        && data.createdAt is timestamp;
    }
    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if verified() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && validListing(request.resource.data);
      allow update: if verified() && owner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validListing(request.resource.data);
      allow delete: if verified() && owner(resource.data.uid);
    }
    match /users/{uid}/favorites/{listingId} {
      allow read, write: if owner(uid);
    }
    match /users/{uid}/data/{dataId} {
      allow read: if owner(uid);
      allow write: if owner(uid) && dataId == 'searches'
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 20;
      allow write: if owner(uid) && dataId == 'preferences'
        && request.resource.data.keys().hasOnly(['countries'])
        && request.resource.data.countries is list
        && request.resource.data.countries.size() <= 12
        && request.resource.data.countries.hasOnly(['AL','TR','GR','RS','SI','XK','MK','HR','BA','ME','BG','RO']);
    }
    match /{document=**} { allow read, write: if false; }
  }
}