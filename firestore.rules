rules_version = '2';

// ===============================================================
// Assumed data model
// ===============================================================
// listings/{listingId}: public vehicle data. Required fields are validated by
// isValidListing(). Ownership and createdAt never change. contactEmail is kept
// as an empty compatibility field so no personally identifiable information is
// exposed in a publicly readable document. There are 1..6 project-owned image
// URLs, each scoped to listings/{uid}/{listingId}/{0..5}.(jpg|png|webp).
// Optional seller metadata: photoDetails maps image slots to {kind, note},
// batteryReport contains {health, measuredAt, issuer, url?}.
// listings/{listingId}/priceHistory/{eventId}: server-recorded price changes.
// chatThreads/{threadId}: server-owned, readable by the participants only.
// chatThreads/{threadId}/messages/{messageId}: server-authored message records.
// users/{uid}/favorites/{listingId}: owner-only {createdAt: timestamp}.
// users/{uid}/data/searches: owner-only {items: list}, maximum 20 validated
// search maps. users/{uid}/data/preferences: owner-only country list.
// users/{uid}/searchAlerts/{alertId}: server-managed search alert configuration.
// users/{uid}/notifications/{notificationId}: server-owned search notifications.
// The recipient can set the read flag to true.
// reports/{uid_listingId}: one immutable, owner-authored report per listing.
// dealerApplications/{uid}: private applications submitted by that account and
// reviewed by a verified administrator with the limbaAdmin custom claim.
// All unspecified paths are denied.

service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Authentication and ownership helpers
    // =============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function canReadListing(data) {
      return data.status == 'active' || isOwner(data.uid);
    }

    function isChatParticipant(data) {
      return isAuthenticated() && request.auth.uid in data.participants;
    }

    // =============================================================
    // Listing validators
    // =============================================================
    function isValidImageUrl(url, pattern) {
      return url.matches(pattern) && url.size() <= 2048;
    }

    function isValidImages(data, listingId) {
      let images = data.images;
      let count = images.size();
      let pattern = 'https://firebasestorage[.]googleapis[.]com/v0/b/limba-auto[.]firebasestorage[.]app/o/listings%2F'
        + data.uid + '%2F' + listingId + '%2F(clean-)?[0-5][.](jpg|png|webp)[?].*';
      return images is list && count >= 1 && count <= 6
        && data.image == images[0]
        && isValidImageUrl(images[0], pattern)
        && (count < 2 || isValidImageUrl(images[1], pattern))
        && (count < 3 || isValidImageUrl(images[2], pattern))
        && (count < 4 || isValidImageUrl(images[3], pattern))
        && (count < 5 || isValidImageUrl(images[4], pattern))
        && (count < 6 || isValidImageUrl(images[5], pattern));
    }

    function isValidPhotoDetail(detail) {
      return detail.keys().hasOnly(['kind', 'note'])
        && detail.kind in ['exterior', 'interior', 'odometer', 'damage', 'other']
        && detail.note.matches('(?s).{0,160}');
    }

    function isValidPhotoDetails(details, imageCount) {
      let validSlots = ['0', '1', '2', '3', '4', '5'][0:imageCount];
      return details.keys().hasOnly(validSlots)
        && (!('0' in details) || isValidPhotoDetail(details['0']))
        && (!('1' in details) || isValidPhotoDetail(details['1']))
        && (!('2' in details) || isValidPhotoDetail(details['2']))
        && (!('3' in details) || isValidPhotoDetail(details['3']))
        && (!('4' in details) || isValidPhotoDetail(details['4']))
        && (!('5' in details) || isValidPhotoDetail(details['5']));
    }

    function isTextOfLength(value, minLength, maxLength) {
      return value is string && value.size() >= minLength && value.size() <= maxLength;
    }

    function isTextAtMost(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isIntegerInRange(value, minValue, maxValue) {
      return value is int && value >= minValue && value <= maxValue;
    }

    function isValidBatteryReport(report) {
      let url = report.get('url', '');
      let health = report.health;
      let measuredAt = report.measuredAt;
      return report.keys().hasOnly(['health', 'measuredAt', 'issuer', 'url'])
        && health is number && health >= 0 && health <= 100
        && measuredAt is string
        && measuredAt.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && isTextOfLength(report.issuer, 1, 120)
        && isTextAtMost(url, 500)
        && (url == '' || url.matches('https://[^/?#\\s]+([/?#][^\\s]*)?'));
    }

    function hasListingFields(data) {
      // The validators below access every required field directly.
      return data.keys().hasOnly([
        'title', 'description', 'price', 'country', 'category', 'city',
        'contactEmail', 'condition', 'image', 'images', 'uid', 'status',
        'createdAt', 'make', 'model', 'year', 'mileage', 'power', 'fuel',
        'transmission', 'body', 'sellerType', 'accidentStatus', 'conditionNote',
        'modelExtension', 'serviceHistory', 'modificationNotes', 'documentNotes',
        'engineName', 'engineCapacity', 'photoDetails', 'batteryReport'
      ]);
    }

    function hasValidListingText(data) {
      let modelExtension = data.get('modelExtension', '');
      return data.uid.matches('(?s).{1,128}')
        && data.title.matches('(?s).{5,110}')
        && data.make.matches('(?s).{2,35}')
        && data.model.matches('(?s).{1,65}')
        && modelExtension.matches('(?s).{0,40}')
        && data.title == data.make + ' ' + data.model + (modelExtension == '' ? '' : ' ' + modelExtension)
        && data.description.matches('(?s).{15,1000}.{0,1000}.{0,1000}')
        && data.city.matches('(?s).{1,90}')
        && data.contactEmail == ''
        && data.get('serviceHistory', '').matches('(?s).{0,500}')
        && data.get('modificationNotes', '').matches('(?s).{0,500}')
        && data.get('documentNotes', '').matches('(?s).{0,240}')
        && data.get('engineName', '').matches('(?s).{0,80}')
        && data.conditionNote.matches('(?s).{0,240}');
    }

    function hasValidListingSpecs(data) {
      return isIntegerInRange(data.price, 1, 999999999)
        && isIntegerInRange(data.get('engineCapacity', 0), 0, 12000)
        && data.category == 'vehicles'
        && data.country in ['AL', 'TR', 'GR', 'RS', 'SI', 'XK', 'MK', 'HR', 'BA', 'ME', 'BG', 'RO']
        && data.condition in ['new', 'used']
        && data.status in ['active', 'sold', 'paused']
        && data.accidentStatus in ['yes', 'no', 'unknown']
        && isIntegerInRange(data.year, 1950, 2100)
        && isIntegerInRange(data.mileage, 0, 1500000)
        && isIntegerInRange(data.power, 1, 2000)
        && data.fuel in ['petrol', 'diesel', 'hybrid', 'electric']
        && data.transmission in ['manual', 'automatic']
        && data.body in ['suv', 'sedan', 'wagon', 'hatchback', 'coupe']
        && data.sellerType in ['privateSeller', 'dealer'];
    }

    function isValidListing(data, listingId) {
      return hasListingFields(data) && hasValidListingText(data) && hasValidListingSpecs(data)
        && data.createdAt is timestamp
        && isValidImages(data, listingId)
        && isValidPhotoDetails(data.get('photoDetails', {}), data.images.size())
        && (!('batteryReport' in data) || (
          data.batteryReport is map && isValidBatteryReport(data.batteryReport)
        ));
    }

    // =============================================================
    // Owner-only account data validators
    // =============================================================
    function isValidFavorite(data, listingId) {
      return listingId.size() >= 1
        && listingId.size() <= 128
        && data.keys().hasAll(['createdAt'])
        && data.keys().hasOnly(['createdAt'])
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && exists(/databases/$(database)/documents/listings/$(listingId))
        && get(/databases/$(database)/documents/listings/$(listingId)).data.status == 'active';
    }

    function isValidSearchFilters(filters) {
      return filters is map
        && filters.keys().hasAll([
          'keyword', 'make', 'model', 'priceTo', 'yearFrom', 'mileageTo',
          'fuel', 'transmission', 'body', 'sellerType', 'priceFrom', 'yearTo'
        ])
        && filters.keys().hasOnly([
          'keyword', 'make', 'model', 'priceTo', 'yearFrom', 'mileageTo',
          'fuel', 'transmission', 'body', 'sellerType', 'priceFrom', 'yearTo',
          'mileageFrom', 'powerFrom', 'powerTo', 'engineTerm', 'capacityFrom', 'capacityTo'
        ])
        && filters.keyword is string && filters.keyword.size() <= 120
        && filters.make is string && filters.make.size() <= 35
        && filters.model is string && filters.model.size() <= 65
        && filters.priceTo is string && filters.priceTo.size() <= 12
        && filters.yearFrom is string && filters.yearFrom.size() <= 4
        && filters.mileageTo is string && filters.mileageTo.size() <= 12
        && filters.fuel is string && filters.fuel.size() <= 16
        && filters.transmission is string && filters.transmission.size() <= 16
        && filters.body is string && filters.body.size() <= 16
        && filters.sellerType is string && filters.sellerType.size() <= 20
        && filters.priceFrom is string && filters.priceFrom.size() <= 12
        && filters.yearTo is string && filters.yearTo.size() <= 4
        && filters.get('mileageFrom','') is string && filters.get('mileageFrom','').size() <= 12
        && filters.get('powerFrom','') is string && filters.get('powerFrom','').size() <= 10
        && filters.get('powerTo','') is string && filters.get('powerTo','').size() <= 10
        && filters.get('engineTerm','') is string && filters.get('engineTerm','').size() <= 80
        && filters.get('capacityFrom','') is string && filters.get('capacityFrom','').size() <= 10
        && filters.get('capacityTo','') is string && filters.get('capacityTo','').size() <= 10;
    }

    function isValidSearchItem(item) {
      return item is map
        && item.keys().hasAll(['name', 'filters', 'countries'])
        && item.keys().hasOnly(['name', 'filters', 'countries'])
        && item.name is string
        && item.name.size() >= 1
        && item.name.size() <= 120
        && isValidSearchFilters(item.filters)
        && item.countries is list
        && item.countries.size() <= 12
        && item.countries.hasOnly(['AL', 'TR', 'GR', 'RS', 'SI', 'XK', 'MK', 'HR', 'BA', 'ME', 'BG', 'RO']);
    }

    function areValidSearchItems(items) {
      return items is list
        && items.size() <= 20
        && (items.size() < 1 || isValidSearchItem(items[0]))
        && (items.size() < 2 || isValidSearchItem(items[1]))
        && (items.size() < 3 || isValidSearchItem(items[2]))
        && (items.size() < 4 || isValidSearchItem(items[3]))
        && (items.size() < 5 || isValidSearchItem(items[4]))
        && (items.size() < 6 || isValidSearchItem(items[5]))
        && (items.size() < 7 || isValidSearchItem(items[6]))
        && (items.size() < 8 || isValidSearchItem(items[7]))
        && (items.size() < 9 || isValidSearchItem(items[8]))
        && (items.size() < 10 || isValidSearchItem(items[9]))
        && (items.size() < 11 || isValidSearchItem(items[10]))
        && (items.size() < 12 || isValidSearchItem(items[11]))
        && (items.size() < 13 || isValidSearchItem(items[12]))
        && (items.size() < 14 || isValidSearchItem(items[13]))
        && (items.size() < 15 || isValidSearchItem(items[14]))
        && (items.size() < 16 || isValidSearchItem(items[15]))
        && (items.size() < 17 || isValidSearchItem(items[16]))
        && (items.size() < 18 || isValidSearchItem(items[17]))
        && (items.size() < 19 || isValidSearchItem(items[18]))
        && (items.size() < 20 || isValidSearchItem(items[19]));
    }

    function isValidSearches(data) {
      return data.keys().hasAll(['items'])
        && data.keys().hasOnly(['items'])
        && areValidSearchItems(data.items);
    }

    function isValidPreferences(data) {
      return data.keys().hasAll(['countries'])
        && data.keys().hasOnly(['countries'])
        && data.countries is list
        && data.countries.size() <= 12
        && data.countries.hasOnly(['AL', 'TR', 'GR', 'RS', 'SI', 'XK', 'MK', 'HR', 'BA', 'ME', 'BG', 'RO']);
    }

    function isValidNotificationRead(data, previous) {
      return data.read == true && data.diff(previous).affectedKeys().hasOnly(['read']);
    }

    function isValidReport(data, reportId) {
      return data.keys().hasAll(['listingId', 'reporterUid', 'reason', 'createdAt'])
        && data.keys().hasOnly(['listingId', 'reporterUid', 'reason', 'createdAt'])
        && data.listingId is string
        && data.listingId.size() >= 1
        && data.listingId.size() <= 128
        && data.reporterUid is string
        && data.reporterUid == request.auth.uid
        && reportId == request.auth.uid + '_' + data.listingId
        && data.reason in ['fraud', 'duplicate', 'inappropriate', 'other']
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && exists(/databases/$(database)/documents/listings/$(data.listingId))
        && get(/databases/$(database)/documents/listings/$(data.listingId)).data.status == 'active';
    }

    // =============================================================
    // Access rules
    // =============================================================
    function requiresSecureWrites() {
      let path = /databases/$(database)/documents/marketplaceSecurity/enforcement;
      return exists(path) && get(path).data.get('requirePipeline', false) == true;
    }

    function hasModerationHold(listingId) {
      return exists(/databases/$(database)/documents/listingModeration/$(listingId));
    }

    function hasPreparedPhotos(data, listingId) {
      let path = /databases/$(database)/documents/listingUploads/$(listingId);
      return exists(path) && get(path).data.used == false
        && get(path).data.expiresAt > request.time
        && get(path).data.uid == data.uid
        && get(path).data.images == data.images
        && getAfter(path).data.used == true;
    }

    function isDealerAdmin() {
      return isVerified() && request.auth.token.get('limbaAdmin', false) == true;
    }

    function hasDealerApproval(uid) {
      let application = /databases/$(database)/documents/dealerApplications/$(uid);
      return exists(application) && get(application).data.status == 'approved';
    }

    function canSetSellerType(data) {
      return data.sellerType != 'dealer' || hasDealerApproval(data.uid);
    }

    function isDealerApplicant(data) {
      return data.keys().hasOnly(['companyName', 'email', 'status', 'createdAt', 'updatedAt', 'reviewerUid'])
        && data.email is string && data.email == request.auth.token.email
        && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 120
        && data.companyName.matches('(?s).*[^\\s].*')
        && data.reviewerUid == '' && data.updatedAt == request.time;
    }

    function canSubmitDealerApplication(known, data) {
      return isVerified() && known.status in ['verificationRequired', 'rejected']
        && isDealerApplicant(data) && data.status == 'pending'
        && data.createdAt == known.createdAt;
    }

    function canReviewDealerApplication(known, data) {
      return isDealerAdmin() && known.status == 'pending'
        && data.status in ['approved', 'rejected']
        && data.reviewerUid == request.auth.uid && data.updatedAt == request.time
        && data.diff(known).affectedKeys().hasOnly(['status', 'reviewerUid', 'updatedAt']);
    }

    match /dealerApplications/{uid} {
      allow get: if isOwner(uid) || isDealerAdmin();
      allow list: if isDealerAdmin() && request.query.limit <= 50;
      allow create: if isOwner(uid) && isDealerApplicant(request.resource.data)
        && request.resource.data.createdAt == request.time
        && ((isVerified() && request.resource.data.status == 'pending')
          || (!isVerified() && request.resource.data.status == 'verificationRequired'));
      allow update: if (isOwner(uid) && canSubmitDealerApplication(resource.data, request.resource.data))
        || canReviewDealerApplication(resource.data, request.resource.data);
    }

    match /marketplaceSecurity/enforcement {
      allow get: if true;
    }

    // Only the verified owner can consume a prepared upload, atomically with creation.
    match /listingUploads/{listingId} {
      allow update: if isVerified() && isOwner(resource.data.uid)
        && resource.data.used == false && resource.data.expiresAt > request.time
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && !exists(/databases/$(database)/documents/listings/$(listingId))
        && getAfter(/databases/$(database)/documents/listings/$(listingId)).data.uid == request.auth.uid;
    }

    match /listings/{listingId} {
      // Public marketplace reads are explicitly limited to active listings.
      allow read: if canReadListing(resource.data);
      allow create: if isVerified()
        && uidUnchanged()
        && request.resource.data.status == 'active'
        && canSetSellerType(request.resource.data)
        && request.resource.data.createdAt == request.time
        && !hasModerationHold(listingId)
        && isValidListing(request.resource.data, listingId)
        && (hasPreparedPhotos(request.resource.data, listingId)
          || (!requiresSecureWrites() && !exists(/databases/$(database)/documents/listingUploads/$(listingId))));
      allow update: if isVerified()
        && isOwner(resource.data.uid)
        && uidNotModified()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.images == resource.data.images
        && request.resource.data.image == resource.data.image
        && (request.resource.data.status != 'active' || !hasModerationHold(listingId))
        && (canSetSellerType(request.resource.data)
          || (request.resource.data.status in ['paused', 'sold']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])))
        && isValidListing(request.resource.data, listingId);
      allow delete: if isVerified() && isOwner(resource.data.uid);

      match /priceHistory/{eventId} {
        allow read: if canReadListing(get(/databases/$(database)/documents/listings/$(listingId)).data);
      }
    }

    match /chatThreads/{threadId} {
      allow get: if isChatParticipant(resource.data);
      allow list: if isChatParticipant(resource.data) && request.query.limit <= 50;

      match /messages/{messageId} {
        allow read: if isChatParticipant(get(/databases/$(database)/documents/chatThreads/$(threadId)).data);
      }
    }

    match /users/{uid}/searchAlerts/{alertId} {
      allow read: if isOwner(uid);
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && isValidNotificationRead(request.resource.data, resource.data);
    }

    match /users/{uid}/favorites/{listingId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isValidFavorite(request.resource.data, listingId);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/data/{dataId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && dataId == 'searches'
        && isValidSearches(request.resource.data);
      allow create, update: if isOwner(uid)
        && dataId == 'preferences'
        && isValidPreferences(request.resource.data);
      allow delete: if isOwner(uid) && dataId in ['searches', 'preferences'];
    }

    match /reports/{reportId} {
      allow create: if isVerified()
        && !requiresSecureWrites()
        && isValidReport(request.resource.data, reportId);
      // Reports are immutable and reviewed only through trusted tooling.
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
