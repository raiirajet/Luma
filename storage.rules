rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{userId}/{listingId}/{fileName} {
      function canManage() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }
      function allowedFile() {
        return fileName.matches('[0-5]\\.(jpg|png|webp)')
          && request.resource.size > 0
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)');
      }
      allow read: if true; // Published vehicle photos are public.
      allow create: if canManage() && allowedFile();
      allow update: if canManage() && allowedFile(); // Editing photos requires ownership.
      allow delete: if canManage();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
