rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{userId}/{listingId}/{fileName} {
      // Only the runtime service account can write new listing photos.
      // Keep previously published JPEG, PNG and WebP images readable.
      allow get: if fileName.matches('(clean-)?[0-5]\\.(jpg|png|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
